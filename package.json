{
  "name": "@portal/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx build site",
    "import:web-serial-rxjs": "bash scripts/import-web-serial-rxjs-static.sh",
    "import:mdn-translation-ja-mcp": "bash scripts/import-mdn-translation-ja-mcp-docs.sh",
    "build:firebase:site": "rm -rf firebase-public && mkdir -p firebase-public && nx build site && cp -R dist/apps/site/browser/. firebase-public/ && mkdir -p firebase-public/updates && cp firebase-public/index.html firebase-public/updates/index.html",
    "build:firebase": "pnpm run build:firebase:site && pnpm run import:web-serial-rxjs && pnpm run import:mdn-translation-ja-mcp",
    "deploy": "firebase deploy --only hosting:gurezo-portal --project gurezo-portal",
    "deploy:firebase": "pnpm run build:firebase && pnpm run deploy",
    "check:links": "node scripts/check-external-links.mjs",
    "test:links": "node --test scripts/check-external-links.test.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
